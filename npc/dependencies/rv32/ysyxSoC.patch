+module gpio_top_apb (
+    input         clock,
+    input         reset,
+    input  [31:0] in_paddr,
+    input         in_psel,
+    input         in_penable,
+    input  [ 2:0] in_pprot,
+    input         in_pwrite,
+    input  [31:0] in_pwdata,
+    input  [ 3:0] in_pstrb,
+    output        in_pready,
+    output [31:0] in_prdata,
+    output        in_pslverr,
+
+    output [15:0] gpio_out,
+    input  [15:0] gpio_in,
+    output [ 7:0] gpio_seg_0,
+    output [ 7:0] gpio_seg_1,
+    output [ 7:0] gpio_seg_2,
+    output [ 7:0] gpio_seg_3,
+    output [ 7:0] gpio_seg_4,
+    output [ 7:0] gpio_seg_5,
+    output [ 7:0] gpio_seg_6,
+    output [ 7:0] gpio_seg_7
 );
 
+  localparam [3:0] GPIO_LED_OFFSET = 4'h0;
+  localparam [3:0] GPIO_SWITCH_OFFSET = 4'h4;
+  localparam [3:0] GPIO_SEGMENT_OFFSET = 4'h8;
+
+  wire apb_access;
+  wire [3:0] register_offset;
+  wire register_offset_supported;
+
+  assign apb_access = in_psel && in_penable;
+  assign register_offset = in_paddr[3:0];
+
+  assign register_offset_supported = (register_offset == GPIO_LED_OFFSET) || (register_offset == GPIO_SWITCH_OFFSET) || (register_offset == GPIO_SEGMENT_OFFSET);
+
+  assign in_pready = 1'b1;
+  assign in_pslverr = apb_access && !register_offset_supported;
+
+  reg [15:0] led_output_q;
+
+  always @(posedge clock) begin
+    if (reset) begin
+      led_output_q <= 16'b0;
+    end else if (apb_access && in_pwrite && register_offset == GPIO_LED_OFFSET) begin
+      if (in_pstrb[0]) begin
+        led_output_q[7:0] <= in_pwdata;
+      end
+      if (in_pstrb[1]) begin
+        led_output_q[15:8] <= in_pwdata[15:8];
+      end
+    end
+  end
+
+  assign gpio_out = led_output_q;
+
+  reg [15:0] gpio_input_metastability_q;
+  reg [15:0] gpio_input_synchronized_q;
+
+  always @(posedge clock) begin
+    if (reset) begin
+      gpio_input_metastability_q <= 16'b0;
+      gpio_input_synchronized_q  <= 16'b0;
+    end else begin
+      gpio_input_metastability_q <= gpio_in;
+      gpio_input_synchronized_q  <= gpio_input_metastability_q;
+    end
+  end
+
+  reg [31:0] seven_segment_digit_values_q;
+
+  always @(posedge clock) begin
+    if (reset) begin
+      seven_segment_digit_values_q <= 32'b0;
+    end else if (apb_access && in_pwrite && register_offset == GPIO_SEGMENT_OFFSET) begin
+      if (in_pstrb[0]) begin
+        seven_segment_digit_values_q[7:0] <= in_pwdata[7:0];
+      end
+      if (in_pstrb[1]) begin
+        seven_segment_digit_values_q[15:8] <= in_pwdata[15:8];
+      end
+      if (in_pstrb[2]) begin
+        seven_segment_digit_values_q[23:16] <= in_pwdata[23:16];
+      end
+      if (in_pstrb[3]) begin
+        seven_segment_digit_values_q[31:24] <= in_pwdata[31:24];
+      end
+    end
+  end
+
+  function [7:0] decode_hex_digit_to_segments;
+    input [3:0] digit;
+    begin
+      case (digit)
+        4'h0:    decode_hex_digit_to_segments = 8'b00000011;
+        4'h1:    decode_hex_digit_to_segments = 8'b10011111;
+        4'h2:    decode_hex_digit_to_segments = 8'b00100101;
+        4'h3:    decode_hex_digit_to_segments = 8'b00001101;
+        4'h4:    decode_hex_digit_to_segments = 8'b10011001;
+        4'h5:    decode_hex_digit_to_segments = 8'b01001001;
+        4'h6:    decode_hex_digit_to_segments = 8'b01000001;
+        4'h7:    decode_hex_digit_to_segments = 8'b00011111;
+        4'h8:    decode_hex_digit_to_segments = 8'b00000001;
+        4'h9:    decode_hex_digit_to_segments = 8'b00001001;
+        4'ha:    decode_hex_digit_to_segments = 8'b00010001;
+        4'hb:    decode_hex_digit_to_segments = 8'b11000001;
+        4'hc:    decode_hex_digit_to_segments = 8'b01100011;
+        4'hd:    decode_hex_digit_to_segments = 8'b10000101;
+        4'he:    decode_hex_digit_to_segments = 8'b01100001;
+        4'hf:    decode_hex_digit_to_segments = 8'b01110001;
+        default: decode_hex_digit_to_segments = 8'b11111111;
+      endcase
+    end
+  endfunction
+
+  assign gpio_seg_0 = decode_hex_digit_to_segments(seven_segment_digit_values_q[3:0]);
+  assign gpio_seg_1 = decode_hex_digit_to_segments(seven_segment_digit_values_q[7:4]);
+  assign gpio_seg_2 = decode_hex_digit_to_segments(seven_segment_digit_values_q[11:8]);
+  assign gpio_seg_3 = decode_hex_digit_to_segments(seven_segment_digit_values_q[15:12]);
+  assign gpio_seg_4 = decode_hex_digit_to_segments(seven_segment_digit_values_q[19:16]);
+  assign gpio_seg_5 = decode_hex_digit_to_segments(seven_segment_digit_values_q[23:20]);
+  assign gpio_seg_6 = decode_hex_digit_to_segments(seven_segment_digit_values_q[27:24]);
+  assign gpio_seg_7 = decode_hex_digit_to_segments(seven_segment_digit_values_q[31:28]);
+
+  reg [31:0] apb_read_data;
+
+  always @(*) begin
+    case (register_offset)
+      GPIO_LED_OFFSET: begin
+        apb_read_data = {16'b0, led_output_q};
+      end
+
+      GPIO_SWITCH_OFFSET: begin
+        apb_read_data = {16'b0, gpio_input_synchronized_q};
+      end
+
+      GPIO_SEGMENT_OFFSET: begin
+        apb_read_data = seven_segment_digit_values_q;
+      end
+
+      default: begin
+        apb_read_data = 32'b0;
+      end
+    endcase
+  end
+
+  assign in_prdata = apb_read_data;
+
 endmodule
diff --git a/perip/ps2/ps2_top_apb.v b/perip/ps2/ps2_top_apb.v
index 080d38fa..96b0dc1a 100644
--- a/perip/ps2/ps2_top_apb.v
+++ b/perip/ps2/ps2_top_apb.v
@@ -16,4 +16,116 @@ module ps2_top_apb(
   input         ps2_data
 );
 
+  localparam [2:0] PS2_DATA_REGISTER_OFFSET = 3'h0;
+  localparam [4:0] SCAN_CODE_FIFO_DEPTH      = 5'd16;
+
+  wire       apb_access;
+  wire [2:0] register_offset;
+  wire       data_register_read_occurred;
+
+  assign apb_access                  = in_psel && in_penable;
+  assign register_offset             = in_paddr[2:0];
+  assign data_register_read_occurred = apb_access && !in_pwrite &&
+                                       (register_offset == PS2_DATA_REGISTER_OFFSET);
+
+  assign in_pready  = 1'b1;
+  assign in_pslverr = apb_access &&
+                      (in_pwrite || (register_offset != PS2_DATA_REGISTER_OFFSET));
+
+  // PS/2 clock and data are asynchronous to the SoC clock. Synchronize both
+  // signals before detecting the PS/2 falling edge used for sampling.
+  reg [2:0] ps2_clock_synchronize_q;
+  reg [1:0] ps2_data_synchronize_q;
+
+  always @(posedge clock) begin
+    if (reset) begin
+      ps2_clock_synchronize_q <= 3'b111;
+      ps2_data_synchronize_q  <= 2'b11;
+    end else begin
+      ps2_clock_synchronize_q <= {ps2_clock_synchronize_q[1:0], ps2_clk};
+      ps2_data_synchronize_q  <= {ps2_data_synchronize_q[0], ps2_data};
+    end
+  end
+
+  wire ps2_clock_falling_edge;
+  wire synchronized_ps2_data;
+
+  assign ps2_clock_falling_edge = ps2_clock_synchronize_q[2] &&
+                                  !ps2_clock_synchronize_q[1];
+  assign synchronized_ps2_data = ps2_data_synchronize_q[1];
+
+  // A PS/2 frame contains start, eight data bits, odd parity and stop.
+  // Bits 0..9 are stored here; the stop bit is checked directly on bit 10.
+  reg [9:0] received_frame_q;
+  reg [3:0] received_bit_count_q;
+
+  wire       complete_frame_received;
+  wire       received_frame_valid;
+  wire [7:0] received_scan_code;
+
+  assign complete_frame_received = ps2_clock_falling_edge &&
+                                   (received_bit_count_q == 4'd10);
+  assign received_frame_valid    = (received_frame_q[0] == 1'b0) &&
+                                   (synchronized_ps2_data == 1'b1) &&
+                                   (^received_frame_q[9:1]);
+  assign received_scan_code      = received_frame_q[8:1];
+
+  always @(posedge clock) begin
+    if (reset) begin
+      received_frame_q     <= 10'b0;
+      received_bit_count_q <= 4'b0;
+    end else if (ps2_clock_falling_edge) begin
+      if (received_bit_count_q == 4'd10) begin
+        received_bit_count_q <= 4'b0;
+      end else begin
+        received_frame_q[received_bit_count_q] <= synchronized_ps2_data;
+        received_bit_count_q                   <= received_bit_count_q + 4'd1;
+      end
+    end
+  end
+
+  // Keep raw Set-2 scan bytes in a FIFO. Prefix bytes such as E0 and F0 must
+  // remain ordered so software can reconstruct extended and release events.
+  reg [7:0] scan_code_fifo_array [0:15];
+  reg [3:0] fifo_read_index_q;
+  reg [3:0] fifo_write_index_q;
+  reg [4:0] fifo_entry_count_q;
+
+  wire scan_code_fifo_read_occurred;
+  wire scan_code_fifo_write_occurred;
+
+  assign scan_code_fifo_read_occurred = data_register_read_occurred &&
+                                        (fifo_entry_count_q != 5'd0);
+  assign scan_code_fifo_write_occurred = complete_frame_received &&
+                                         received_frame_valid &&
+                                         ((fifo_entry_count_q < SCAN_CODE_FIFO_DEPTH) ||
+                                          scan_code_fifo_read_occurred);
+
+  always @(posedge clock) begin
+    if (reset) begin
+      fifo_read_index_q  <= 4'b0;
+      fifo_write_index_q <= 4'b0;
+      fifo_entry_count_q <= 5'b0;
+    end else begin
+      if (scan_code_fifo_write_occurred) begin
+        scan_code_fifo_array[fifo_write_index_q] <= received_scan_code;
+        fifo_write_index_q                       <= fifo_write_index_q + 4'd1;
+      end
+
+      if (scan_code_fifo_read_occurred) begin
+        fifo_read_index_q <= fifo_read_index_q + 4'd1;
+      end
+
+      case ({scan_code_fifo_write_occurred, scan_code_fifo_read_occurred})
+        2'b10: fifo_entry_count_q <= fifo_entry_count_q + 5'd1;
+        2'b01: fifo_entry_count_q <= fifo_entry_count_q - 5'd1;
+        default: ;
+      endcase
+    end
+  end
+
+  assign in_prdata = (fifo_entry_count_q != 5'd0)
+                   ? {24'b0, scan_code_fifo_array[fifo_read_index_q]}
+                   : 32'b0;
+
 endmodule
