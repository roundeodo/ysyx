+  // 从实际解析训练建立四种状态；检查同一条件分支的前/后向静态与动态选择。
+  task automatic check_conditional_prediction_states;
+    localparam program_counter_t PC = program_counter_t'('h8000_0600);
+    program_counter_t target;
+    bit expected_taken;
+    for (int backward = 0; backward < 2; backward++) begin
+      target = backward ? PC - program_counter_t'(8) : PC + program_counter_t'(8);
+      // 三次not-taken保证任何初始两位状态都饱和到00，同时安装当前目标。
+      @(negedge clk);
+      predictor_resolved_control_flow_pc = PC;
+      predictor_resolved_control_flow_target = target;
+      predictor_resolved_control_flow_op = CF_BRANCH;
+      predictor_resolved_control_flow_rd = '0;
+      predictor_resolved_control_flow_rs1 = '0;
+      predictor_resolved_control_flow_taken = 1'b0;
+      predictor_resolved_control_flow_occurred = 1'b1;
+      repeat (3) @(posedge clk);
+      @(negedge clk);
+      predictor_resolved_control_flow_occurred = 1'b0;
+      for (int counter = 0; counter < 4; counter++) begin
+        if (counter != 0) begin
+          predictor_resolved_control_flow_taken = 1'b1;
+          predictor_resolved_control_flow_occurred = 1'b1;
+          @(posedge clk);
+          @(negedge clk);
+          predictor_resolved_control_flow_occurred = 1'b0;
+        end
+        query_predictor(PC);
+        case (riscv_config_pkg::BRANCH_STATIC_POLICY)
+          0: expected_taken = counter >= 2;
+          1: expected_taken = backward != 0;
+          2: begin
+            case (counter)
+              0: expected_taken = 1'b0;
+              3: expected_taken = 1'b1;
+              default: expected_taken = backward != 0;
+            endcase
+          end
+          default: $fatal(1, "unsupported branch choice in pipeline test");
+        endcase
+        assert (predictor_lookup_prediction.predicted_taken == expected_taken &&
+                predictor_lookup_next_pc == (expected_taken ? target :
+                    PC + program_counter_t'(INSTRUCTION_BYTES)))
+        else $fatal(1, "conditional choice mismatch: policy=%0d backward=%0d state=%0d",
+                    riscv_config_pkg::BRANCH_STATIC_POLICY, backward, counter);
+      end
+    end
+    clear_predictor_inputs();
+    $display("PASS conditional choice: 8 direction/state combinations, policy=%0d",
+             riscv_config_pkg::BRANCH_STATIC_POLICY);
+  endtask
