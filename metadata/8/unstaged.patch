+		--output $(STA_QUALIFIED_OUTPUT_DIR) --frequency $(STA_QUALIFIED_FREQUENCY_MHZ) \
+		--fanout $(STA_MAX_FANOUT) --headroom $(STA_CAPACITANCE_FRACTION)
