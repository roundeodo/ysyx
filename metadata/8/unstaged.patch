-  always_ff @(posedge clk_i or negedge rst_ni) begin
-    if (!rst_ni) begin
-      write_state_q    <= WRITE_ACCEPT_ADDRESS;
-      write_response_q <= '0;
-    end else begin
-      write_state_q    <= write_state_d;
-      write_response_q <= write_response_d;
-    end
-  end
-
