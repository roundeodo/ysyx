-        branch_target = execute_packet_i.uop.pc + execute_packet_i.uop.imm;
-      end
-      CF_JALR: begin
-        branch_taken  = 1'b1;
-        branch_target = (execute_packet_i.rs1_value + execute_packet_i.uop.imm) & ~32'h1;
-      end
-      default: ;
-    endcase
-  end
-
-  assign csr_operand = execute_packet_i.uop.csr_ctrl.use_imm ?
