+	mkdir -p $(STA_OUTPUT_ROOT)/riscv_core_reset_boundary-$(STA_MAPPING_FREQUENCY_MHZ)MHz
+	$(STA_YOSYS) $(STA_YOSYS_PLUGIN_FLAGS) $(STA_YOSYS_DEBUG_FLAGS) \
