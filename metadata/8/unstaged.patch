-      4'b0001: out = in1 - in2;
-      4'b0010: out = in1 << in2[4:0];
-      4'b0011: out = {31'b0, $signed(in1) < $signed(in2)};
-      4'b0100: out = {31'b0, in1 < in2};
-      4'b0101: out = in1 ^ in2;
-      4'b0110: out = in1 >> in2[4:0];
-      4'b0111: out = $signed(in1) >>> in2[4:0];
