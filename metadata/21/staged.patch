diff --git a/tests/cpu-tests/tests/icache-sdram-burst-test.c b/tests/cpu-tests/tests/icache-sdram-burst-test.c
new file mode 100644
index 0000000..1b1ee74
--- /dev/null
+++ b/tests/cpu-tests/tests/icache-sdram-burst-test.c
@@ -0,0 +1,24 @@
+#include "trap.h"
+
+#include <stdint.h>
+
+#define SDRAM_EXEC_BASE_ADDR 0xa0000000u
+
+typedef uint32_t (*sdram_test_function_t)(void);
+
+int main(void) {
+  volatile uint32_t *const sdram_instructions =
+      (volatile uint32_t *)(uintptr_t)SDRAM_EXEC_BASE_ADDR;
+
+  // 写入addi a0, x0, 42和返回指令，作为之后从SDRAM执行的最小函数。
+  sdram_instructions[0] = 0x02a00513u;
+  sdram_instructions[1] = 0x00008067u;
+
+  // 前面的store修改了未来要取指的地址；跳转前用fence.i清除旧I-cache状态。
+  __asm__ volatile("fence.i" ::: "memory");
+
+  const sdram_test_function_t sdram_test_function =
+      (sdram_test_function_t)(uintptr_t)SDRAM_EXEC_BASE_ADDR;
+  check(sdram_test_function() == 42u);
+  return 0;
+}
diff --git a/tests/cpu-tests/tests/mem-test.c b/tests/cpu-tests/tests/mem-test.c
new file mode 100644
index 0000000..bc080e2
--- /dev/null
+++ b/tests/cpu-tests/tests/mem-test.c
@@ -0,0 +1,65 @@
+#include "trap.h"
+#include <stdint.h>
+
+#define PSRAM_TEST_START_ADDR ((uintptr_t)0x80000000u)
+#define PSRAM_TEST_END_ADDR   ((uintptr_t)0x80400000u)
+
+static uintptr_t align_up(uintptr_t addr, uintptr_t alignment) {
+  return (addr + alignment - 1) & ~(alignment - 1);
+}
+
+int main(void) {
+  const uintptr_t start = PSRAM_TEST_START_ADDR;
+  const uintptr_t end   = PSRAM_TEST_END_ADDR;
+
+  // Cover every PSRAM byte with 8-bit stores and loads.
+  for (uintptr_t addr = start; addr < end; addr++) {
+    *(volatile uint8_t *)addr = (uint8_t)(addr ^ 0x5a);
+  }
+
+  for (uintptr_t addr = start; addr < end; addr++) {
+    uint8_t expected = (uint8_t)(addr ^ 0x5a);
+    if (*(volatile uint8_t *)addr != expected) {
+      halt(1);
+    }
+  }
+
+  // Cover the complete PSRAM range with naturally aligned 16-bit accesses.
+  for (uintptr_t addr = align_up(start, 2); addr + 2 <= end; addr += 2) {
+    *(volatile uint16_t *)addr = (uint16_t)(addr ^ 0xa55a);
+  }
+
+  for (uintptr_t addr = align_up(start, 2); addr + 2 <= end; addr += 2) {
+    uint16_t expected = (uint16_t)(addr ^ 0xa55a);
+    if (*(volatile uint16_t *)addr != expected) {
+      halt(2);
+    }
+  }
+
+  // Cover the complete PSRAM range with naturally aligned 32-bit accesses.
+  for (uintptr_t addr = align_up(start, 4); addr + 4 <= end; addr += 4) {
+    *(volatile uint32_t *)addr = (uint32_t)(addr ^ 0xa5a55a5a);
+  }
+
+  for (uintptr_t addr = align_up(start, 4); addr + 4 <= end; addr += 4) {
+    uint32_t expected = (uint32_t)(addr ^ 0xa5a55a5a);
+    if (*(volatile uint32_t *)addr != expected) {
+      halt(3);
+    }
+  }
+
+  // RV32 implements each 64-bit C access as multiple 32-bit instructions.
+  for (uintptr_t addr = align_up(start, 8); addr + 8 <= end; addr += 8) {
+    uint64_t expected = ((uint64_t)(addr ^ 0x5aa55aa5u) << 32) | addr;
+    *(volatile uint64_t *)addr = expected;
+  }
+
+  for (uintptr_t addr = align_up(start, 8); addr + 8 <= end; addr += 8) {
+    uint64_t expected = ((uint64_t)(addr ^ 0x5aa55aa5u) << 32) | addr;
+    if (*(volatile uint64_t *)addr != expected) {
+      halt(4);
+    }
+  }
+
+  return 0;
+}
diff --git a/tests/cpu-tests/tests/psram-test.c b/tests/cpu-tests/tests/psram-test.c
new file mode 100644
index 0000000..a629573
--- /dev/null
+++ b/tests/cpu-tests/tests/psram-test.c
@@ -0,0 +1,133 @@
+#include "trap.h"
+
+#include <stdint.h>
+#include <stdio.h>
+
+#define PSRAM_TEST_BASE_ADDR 0x80000000u
+#define PSRAM_TEST_BYTE_SIZE 0x00001000u
+
+static void test_byte_access(void) {
+  volatile uint8_t *const psram =
+      (volatile uint8_t *)(uintptr_t)PSRAM_TEST_BASE_ADDR;
+
+  printf("PSRAM: testing 8-bit accesses...\n");
+
+  for (uint32_t byte_offset = 0; byte_offset < PSRAM_TEST_BYTE_SIZE;
+       byte_offset++) {
+    psram[byte_offset] = (uint8_t)(byte_offset ^ 0x5au);
+  }
+
+  for (uint32_t byte_offset = 0; byte_offset < PSRAM_TEST_BYTE_SIZE;
+       byte_offset++) {
+    const uint8_t expected = (uint8_t)(byte_offset ^ 0x5au);
+    const uint8_t actual   = psram[byte_offset];
+
+    if (actual != expected) {
+      printf("PSRAM 8-bit mismatch: addr=0x%x expected=0x%x actual=0x%x\n",
+             PSRAM_TEST_BASE_ADDR + byte_offset, expected, actual);
+      halt(1);
+    }
+  }
+}
+
+static void test_halfword_access(void) {
+  volatile uint16_t *const psram =
+      (volatile uint16_t *)(uintptr_t)PSRAM_TEST_BASE_ADDR;
+  const uint32_t halfword_count = PSRAM_TEST_BYTE_SIZE / sizeof(uint16_t);
+
+  printf("PSRAM: testing 16-bit accesses...\n");
+
+  for (uint32_t halfword_index = 0; halfword_index < halfword_count;
+       halfword_index++) {
+    const uint32_t byte_offset = halfword_index * sizeof(uint16_t);
+    psram[halfword_index] = (uint16_t)(byte_offset ^ 0xa55au);
+  }
+
+  for (uint32_t halfword_index = 0; halfword_index < halfword_count;
+       halfword_index++) {
+    const uint32_t byte_offset = halfword_index * sizeof(uint16_t);
+    const uint16_t expected    = (uint16_t)(byte_offset ^ 0xa55au);
+    const uint16_t actual      = psram[halfword_index];
+
+    if (actual != expected) {
+      printf("PSRAM 16-bit mismatch: addr=0x%x expected=0x%x actual=0x%x\n",
+             PSRAM_TEST_BASE_ADDR + byte_offset, expected, actual);
+      halt(2);
+    }
+  }
+}
+
+static void test_word_access(void) {
+  volatile uint32_t *const psram =
+      (volatile uint32_t *)(uintptr_t)PSRAM_TEST_BASE_ADDR;
+  const uint32_t word_count = PSRAM_TEST_BYTE_SIZE / sizeof(uint32_t);
+
+  printf("PSRAM: testing 32-bit accesses...\n");
+
+  for (uint32_t word_index = 0; word_index < word_count; word_index++) {
+    const uint32_t byte_offset = word_index * sizeof(uint32_t);
+    psram[word_index] = byte_offset ^ 0xa5a55a5au;
+  }
+
+  for (uint32_t word_index = 0; word_index < word_count; word_index++) {
+    const uint32_t byte_offset = word_index * sizeof(uint32_t);
+    const uint32_t expected    = byte_offset ^ 0xa5a55a5au;
+    const uint32_t actual      = psram[word_index];
+
+    if (actual != expected) {
+      printf("PSRAM 32-bit mismatch: addr=0x%x expected=0x%x actual=0x%x\n",
+             PSRAM_TEST_BASE_ADDR + byte_offset, expected, actual);
+      halt(3);
+    }
+  }
+}
+
+static void test_doubleword_access(void) {
+  volatile uint64_t *const psram =
+      (volatile uint64_t *)(uintptr_t)PSRAM_TEST_BASE_ADDR;
+  const uint32_t doubleword_count = PSRAM_TEST_BYTE_SIZE / sizeof(uint64_t);
+
+  printf("PSRAM: testing 64-bit accesses as RV32 word pairs...\n");
+
+  for (uint32_t doubleword_index = 0;
+       doubleword_index < doubleword_count; doubleword_index++) {
+    const uint32_t byte_offset = doubleword_index * sizeof(uint64_t);
+    const uint64_t pattern =
+        ((uint64_t)(byte_offset ^ 0x89abcdefu) << 32) |
+        (uint64_t)(byte_offset ^ 0x01234567u);
+
+    psram[doubleword_index] = pattern;
+  }
+
+  for (uint32_t doubleword_index = 0;
+       doubleword_index < doubleword_count; doubleword_index++) {
+    const uint32_t byte_offset = doubleword_index * sizeof(uint64_t);
+    const uint64_t expected =
+        ((uint64_t)(byte_offset ^ 0x89abcdefu) << 32) |
+        (uint64_t)(byte_offset ^ 0x01234567u);
+    const uint64_t actual = psram[doubleword_index];
+
+    if (actual != expected) {
+      printf("PSRAM 64-bit mismatch: addr=0x%x\n",
+             PSRAM_TEST_BASE_ADDR + byte_offset);
+      printf("  expected: high=0x%x low=0x%x\n",
+             (uint32_t)(expected >> 32), (uint32_t)expected);
+      printf("  actual:   high=0x%x low=0x%x\n",
+             (uint32_t)(actual >> 32), (uint32_t)actual);
+      halt(4);
+    }
+  }
+}
+
+int main(void) {
+  printf("PSRAM test range: [0x%x, 0x%x)\n", PSRAM_TEST_BASE_ADDR,
+         PSRAM_TEST_BASE_ADDR + PSRAM_TEST_BYTE_SIZE);
+
+  test_byte_access();
+  test_halfword_access();
+  test_word_access();
+  test_doubleword_access();
+
+  printf("PSRAM test passed.\n");
+  return 0;
+}
diff --git a/tests/cpu-tests/tests/sdram-test.c b/tests/cpu-tests/tests/sdram-test.c
new file mode 100644
index 0000000..c9ce532
--- /dev/null
+++ b/tests/cpu-tests/tests/sdram-test.c
@@ -0,0 +1,91 @@
+#include "trap.h"
+
+#include <stdint.h>
+#include <stdio.h>
+
+#define SDRAM_TEST_BASE_ADDR 0xa0000000u
+#define SDRAM_TEST_BYTE_SIZE 0x00001000u
+
+static uint32_t select_word_test_pattern(uint32_t word_index) {
+  const uint32_t byte_offset = word_index * sizeof(uint32_t);
+  return (SDRAM_TEST_BASE_ADDR + byte_offset) ^ 0xa5a55a5au;
+}
+
+static void test_complete_word_range(void) {
+  volatile uint32_t *const sdram_words =
+      (volatile uint32_t *)(uintptr_t)SDRAM_TEST_BASE_ADDR;
+  const uint32_t word_count = SDRAM_TEST_BYTE_SIZE / sizeof(uint32_t);
+
+  printf("SDRAM: testing 4 KiB with 32-bit accesses...\n");
+
+  for (uint32_t word_index = 0; word_index < word_count; word_index++) {
+    sdram_words[word_index] = select_word_test_pattern(word_index);
+  }
+
+  for (uint32_t word_index = 0; word_index < word_count; word_index++) {
+    const uint32_t expected = select_word_test_pattern(word_index);
+    const uint32_t actual   = sdram_words[word_index];
+
+    if (actual != expected) {
+      const uint32_t failed_addr =
+          SDRAM_TEST_BASE_ADDR + word_index * sizeof(uint32_t);
+      printf("SDRAM word mismatch: addr=0x%x expected=0x%x actual=0x%x\n",
+             failed_addr, expected, actual);
+      halt(1);
+    }
+  }
+}
+
+static void test_byte_write_strobes(void) {
+  const uintptr_t test_addr = SDRAM_TEST_BASE_ADDR + 0x100u;
+  volatile uint32_t *const test_word =
+      (volatile uint32_t *)(uintptr_t)test_addr;
+  volatile uint8_t *const test_bytes =
+      (volatile uint8_t *)(uintptr_t)test_addr;
+
+  printf("SDRAM: testing four byte write strobes...\n");
+
+  *test_word     = 0u;
+  test_bytes[0] = 0x11u;
+  test_bytes[1] = 0x22u;
+  test_bytes[2] = 0x33u;
+  test_bytes[3] = 0x44u;
+
+  if (*test_word != 0x44332211u) {
+    printf("SDRAM byte-strobe mismatch: expected=0x44332211 actual=0x%x\n",
+           *test_word);
+    halt(2);
+  }
+}
+
+static void test_halfword_write_strobes(void) {
+  const uintptr_t test_addr = SDRAM_TEST_BASE_ADDR + 0x200u;
+  volatile uint32_t *const test_word =
+      (volatile uint32_t *)(uintptr_t)test_addr;
+  volatile uint16_t *const test_halfwords =
+      (volatile uint16_t *)(uintptr_t)test_addr;
+
+  printf("SDRAM: testing two halfword write strobes...\n");
+
+  *test_word         = 0u;
+  test_halfwords[0] = 0x55aau;
+  test_halfwords[1] = 0xa55au;
+
+  if (*test_word != 0xa55a55aau) {
+    printf("SDRAM halfword-strobe mismatch: expected=0xa55a55aa actual=0x%x\n",
+           *test_word);
+    halt(3);
+  }
+}
+
+int main(void) {
+  printf("SDRAM test range: [0x%x, 0x%x)\n", SDRAM_TEST_BASE_ADDR,
+         SDRAM_TEST_BASE_ADDR + SDRAM_TEST_BYTE_SIZE);
+
+  test_complete_word_range();
+  test_byte_write_strobes();
+  test_halfword_write_strobes();
+
+  printf("SDRAM test passed.\n");
+  return 0;
+}
